RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

ORDER_CACHE_TTL=5m
ORDER_RATE_LIMIT_ENABLED=true
ORDER_RATE_LIMIT_REQUESTS=10
ORDER_RATE_LIMIT_WINDOW=1m

NOTIFICATION_IDEMPOTENCY_TTL=24h
NOTIFICATION_RETRY_COUNT=4
NOTIFICATION_RETRY_BASE_DELAY=2s

PROVIDER_MODE=SIMULATED
SIMULATED_PROVIDER_LATENCY=750ms
SIMULATED_PROVIDER_FAILURE_RATE=0.25

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=10s
